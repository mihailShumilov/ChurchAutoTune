## Спільні слова, клавіші та перевірки

common-yes = Так
common-no = Ні
common-retry = Ще раз
common-microphone = Мікрофон
common-step = Крок { $number } з { $total }

keys-info = [Enter] далі · [B] назад · [Q] зберегти й вийти
keys-confirm = [Enter] так · 2 або «ні» — ні · [B] назад · [Q] зберегти й вийти
keys-choose = Введіть номер або натисніть [Enter] для рекомендованого варіанта
keys-input = Введіть і натисніть [Enter]
keys-task = Зробіть це й натисніть [Enter] · [Q] зберегти й вийти
keys-typed = Введіть слово й натисніть [Enter]

tui-keys-info = [Enter] далі
tui-keys-choose = [↑ ↓] вибрати · [Enter] підтвердити
tui-keys-input = Введіть і натисніть [Enter]
tui-keys-task = Зробіть це й натисніть [Enter]
tui-keys-typed = Введіть слово й натисніть [Enter]
tui-keys-back = [Esc] назад
tui-keys-quit = [Ctrl+Q] зберегти й вийти

check-ok = ✓ ОК
check-warn = ! Перевірте
check-fail = ✗ Проблема
check-result = Підсумок
check-what = Що

sound-warning = Зараз пролунає тестовий сигнал. Біля колонок не має бути людей із чутливим слухом. Зніміть навушники.
sound-stop-keys = Ctrl+C або пробіл одразу вимикають звук.
sound-stop-ctrl-c = Ctrl+C одразу вимикає звук.

gate-clipping = Мікрофон перевантажений: зменште його gain або грайте тихіше.
gate-hot = Майже перевантаження: трохи зменште gain.
gate-quiet = Дуже тихо: перевірте фантомне живлення (+48V) і gain.
gate-low-snr = У залі надто шумно для цього рівня: попросіть тиші або зробіть трохи гучніше.
gate-low-pnr = Результат надто шумний: повторіть у тиші.
gate-xrun = Звуковий потік переривався: закрийте інші програми й повторіть.
gate-unsteady = Два свипи відрізняються: щось зрушило або шуміло. Повторіть.

noise-hum = { $mic }: гул мережі (димери, LED-драйвери). Вимкніть світло на сцені.
noise-rumble = { $mic }: низькочастотний шум (вентиляція, кондиціонер). Вимкніть, якщо можна.
noise-loud = { $mic }: у залі шумно (розмови, кроки, вулиця). Попросіть тиші.
common-recommended = (рекомендовано)
common-default = Enter залишить: { $value }
common-save-quit = Зберегти й вийти
common-mic = Мікрофон { $number } (USB-вхід { $usb })
common-mic-number = Мікрофон { $number }
common-dbfs = { $level } dBFS
plain-invalid-choice = Введіть номер від 1 до { $count }.
sound-play = Увімкнути звук
sound-later = Поки ні
sound-playing = Звучить тестовий сигнал · [пробіл] або [Ctrl+C] — зупинити
sound-playing-plain = Звучить тестовий сигнал. Ctrl+C — зупинити.
sound-countdown = Відійдіть від мікрофонів: звук почнеться за 3 секунди
sound-stopped = Звук зупинено.
session-saved-resume = Сесію збережено. Продовжити пізніше: ctune resume
tui-quit-pending = Зупиняю. Сесія збережеться на наступному запитанні.
audio-problem-channels = менше 32 каналів
audio-problem-sample-rate = працює не на 48 кГц
signal-off = вимкнено
signal-main-l = Main L
signal-main-r = Main R
signal-mono = Main Mono
signal-bus = шина { $number }
signal-matrix = матриця { $number }
signal-direct-channel = прямий вихід каналу { $number }
signal-direct-aux = прямий вихід aux-входу { $number }
signal-direct-fx = прямий вихід повернення ефекту { $number }
signal-monitor = моніторний вихід
signal-talkback = talkback
signal-unknown = невідоме джерело
output-main = вихід { $number }
output-aux = aux-вихід { $number }
alignment-delay = { $where }: затримка { $ms } мс
alignment-polarity = { $where }: перевернута полярність
